<script>
(function () {
  const defaultConfig = {
    websiteId: "bba4298a-4094-4446-82f3-08020a4bd112",
    projectName: "Portainer Support",
    modalTitle: "Ask the Portainer Support AI",
    launcherButtonText: "Ask AI",
    modalDisclaimer: "This is an AI-powered bot, trained on a number of sources including Portainer's website, documentation, knowledge base as well as GitHub issues and responses. Please use your best judgment when implementing any solutions suggested by the bot. The bot works best when you give it as much context as possible, so if the bot isn't able to answer your question immediately try adding more context."
  };

  const alternateUrls = [
    "/contact-sales",
    "/pricing"
  ];

  const alternateConfig = {
    websiteId: "34e3cc28-bfd7-444b-bad6-bda6fbeafca2",
    projectName: "Portainer",
    modalTitle: "Ask the Portainer Sales AI",
    launcherButtonText: "Ask AI",
    modalDisclaimer: "This is an AI-powered bot, trained on the Portainer suite of products. For support queries, please use the support AI on our Get Support page. The bot works best when you give it as much context as possible, so if the bot isn't able to answer your question immediately try adding more context."
  };


  const path = window.location.pathname.replace(/\/$/, "") || "/";

  const useAlternateConfig = alternateUrls.includes(path);

  const config = useAlternateConfig
    ? { ...defaultConfig, ...alternateConfig }
    : defaultConfig;

  const script = document.createElement("script");
  script.async = true;
  script.src = "https://widget.kapa.ai/kapa-widget.bundle.js";

  script.dataset.websiteId = config.websiteId;
  script.dataset.projectName = config.projectName;
  script.dataset.projectColor = "#000000";
  script.dataset.projectLogo = "https://downloads.portainer.io/assets/portainer-p-logo-280x280.png";
  script.dataset.colorScheme = "light";
  script.dataset.searchModeEnabled = "true";
  script.dataset.modalYOffset = "8vh";
  script.dataset.modalTitle = config.modalTitle;
  script.dataset.launcherButtonText = config.launcherButtonText;
  script.dataset.modalDisclaimer = config.modalDisclaimer;
  script.dataset.modalOverrideOpenSelector = "#kapa-open-link";

  document.head.appendChild(script);
})();
</script>


